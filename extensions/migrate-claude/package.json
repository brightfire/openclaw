{
  "name": "@openclaw/migrate-claude",
  "version": "2026.8.2-50",
  "private": true,
  "description": "Claude to OpenClaw migration provider",
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.2-50"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "bundledDist": true
    }
  }
}
